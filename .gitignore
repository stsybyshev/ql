# Environment and secrets
.env
.env.*
*.key

# Test results (generated, not committed)
test/results/

# OS files
.DS_Store
Thumbs.db

# Python virtualenvs (uv creates .venv per project; 300MB+)
.venv/
venv/

# Python bytecode and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Local runtime state (also lives outside the repo, but belt and braces)
*.jsonl
!tests/**/*.jsonl

# Personal food cache — records what the user actually eats. Kept local.
# A committed template (personal-foods.example.yaml) seeds a fresh install.
personal-foods.yaml

# Real food logs — timestamped meals are personal data. Small synthetic
# fixtures under tests/fixtures/ stay tracked; generated months do not.
skills/nutrition-tracker/dist/openclaw-food-tracker/assets/*.md
